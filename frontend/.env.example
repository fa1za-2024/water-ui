# Water UI - frontend environment template
# Copy to .env:  cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_ to the browser, and it BAKES
# them in at build time - so these are not secrets and changing one requires a
# rebuild.

# Base path for the REST API. Kept relative on purpose: the Vite dev server
# proxies it (see vite.config.js) and nginx proxies it in production. That keeps
# the browser same-origin, so there is no CORS surface.
VITE_API_BASE_URL=/api

# Optional: point Socket.io at a different origin. Leave it unset for
# same-origin, which is what both proxies provide.
# VITE_SOCKET_URL=http://localhost:5000

# Broker the Simulator page defaults to. Must use a TLS scheme (mqtts://) because
# the external EMQX cluster only exposes MQTT over TLS on 8883.
# VITE_MQTT_BROKER_URL=mqtts://n1119107.ala.asia-southeast1.emqxsl.com
# VITE_MQTT_PORT=8883
