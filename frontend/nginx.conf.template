# =============================================================================
# Water UI - nginx site config TEMPLATE
#
# Copied to /etc/nginx/templates/default.conf.template in the image. The stock
# nginx entrypoint runs envsubst over it at container start and writes the
# result to /etc/nginx/conf.d/default.conf, substituting ONLY the environment
# variables that are actually set (nginx's own $host / $uri / $remote_addr and
# friends are left alone - they are not environment variables).
#
# Two values are environment-driven so the same image works in every
# environment:
#
#   PORT              - the port nginx listens on. 80 in Compose; Railway
#                       injects/assigns a port and routes its domain to it.
#   BACKEND_UPSTREAM  - scheme://host:port of the API. The Compose service name
#                       (`http://backend:5000`) locally; the backend service's
#                       private domain on Railway
#                       (`http://${{backend.RAILWAY_PRIVATE_DOMAIN}}:8080`),
#                       because `backend` is not a resolvable name there.
#   DNS_RESOLVER      - nameserver nginx uses to re-resolve BACKEND_UPSTREAM.
#                       Set by 05-resolver.envsh from the container's own
#                       /etc/resolv.conf; the Dockerfile carries a fallback.
#
# Defaults live in the Dockerfile (ENV PORT=80, BACKEND_UPSTREAM=http://backend:5000)
# so `docker compose --profile app up` behaves exactly as before.
# =============================================================================

server {
    listen ${PORT};
    server_name _;

    # proxy_pass is given a VARIABLE below, which makes nginx re-resolve the
    # backend per request instead of caching the address it saw at startup. That
    # matters because the backend is assigned a new private address on every
    # Railway deploy; without it the frontend answers 504 until it is restarted
    # too. DNS_RESOLVER comes from 05-resolver.envsh.
    resolver ${DNS_RESOLVER} valid=10s;

    root /usr/share/nginx/html;
    index index.html;

    # --- Compression --------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # --- Hashed build assets: safe to cache forever -------------------------
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # --- REST API -> Express ------------------------------------------------
    location /api/ {
        set $backend_upstream ${BACKEND_UPSTREAM};
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- Socket.io -> Express (needs the Upgrade headers) -------------------
    location /socket.io/ {
        set $backend_upstream ${BACKEND_UPSTREAM};
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host       $host;
        proxy_read_timeout 7d;   # keep long-lived sockets alive
        proxy_send_timeout 7d;
    }

    # --- SPA fallback: every other path resolves to index.html --------------
    # React Router owns client-side routes (e.g. /boards, /historical).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
