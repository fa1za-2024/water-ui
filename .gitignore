# --- Dependencies -----------------------------------------------------------
node_modules/

# --- Build output -----------------------------------------------------------
frontend/dist/
backend/dist/

# --- Prisma -----------------------------------------------------------------
# The client is generated by `prisma generate` into the backend source tree.
backend/src/generated/

# --- Secrets ----------------------------------------------------------------
# .env.example IS committed; the real .env must never be.
.env
.env.local
.env.*.local

# --- Node-RED runtime artefacts ---------------------------------------------
# iot/node-red is bind-mounted at /data inside the container, so Node-RED and
# npm write into the repo. flows.json, settings.js and package.json are source
# and ARE committed; everything below is generated.
iot/node-red/.config.*
iot/node-red/.sessions.json
iot/node-red/.backup/
iot/node-red/.npm/
iot/node-red/lib/
iot/node-red/flows_cred.json

# --- Logs / OS noise --------------------------------------------------------
*.log
.DS_Store
Thumbs.db
