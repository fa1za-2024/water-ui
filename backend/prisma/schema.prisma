// Water UI - MySQL schema (relational metadata)
//
// Mirrors MASTER_CONTEXT.md section 4.1 and docs/database.md section 1 exactly:
// the same column names, the same types, the same constraints.
//
// Prisma 7 note: the legacy `prisma-client-js` generator was REMOVED in v7, so
// this uses the new `prisma-client` generator with an explicit `output`. The
// client is therefore imported from ../src/generated/prisma, NOT from
// '@prisma/client'. Also, MySQL now requires a driver adapter at runtime
// (see src/config/db.ts).
//
// The generated client is TypeScript and uses ESM import syntax - which is WHY
// this backend is TypeScript: tsc compiles src/ (including the generated client)
// down to CommonJS in dist/.
//
// Do NOT set `generatedFileExtension = "js"`. Prisma warns it is "unexpected"
// and emits ESM JavaScript, which the CommonJS backend cannot load:
//   SyntaxError: Cannot use import statement outside a module

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

// Prisma 7 REMOVED the `url` property from the datasource block. It must not
// appear here:
//   "The datasource property `url` is no longer supported in schema files."
// The Migrate/CLI connection URL now lives in prisma.config.ts, and the runtime
// connection goes through the MariaDB driver adapter in src/config/db.js.
datasource db {
  provider = "mysql"
}

/// Single user profile. There is no RBAC in this system, so no roles,
/// no permissions and no user<->board junction table.
model User {
  id                Int      @id @default(autoincrement())
  firstName         String   @map("first_name") @db.VarChar(50)
  lastName          String   @map("last_name") @db.VarChar(50)
  email             String   @unique @db.VarChar(100)
  phone             String   @unique @db.VarChar(20)
  passwordHash      String   @map("password_hash") @db.VarChar(255)
  profilePictureUrl String?  @map("profile_picture_url") @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// Registry of the physical IoT devices in the field.
/// `boardId` is the logical id ("AA240238") that also appears as the
/// `board_id` tag in InfluxDB and as `boardID` on the MQTT wire.
model Board {
  id              Int      @id @default(autoincrement())
  boardId         String   @unique @map("board_id") @db.VarChar(50)
  boardMacAddress String   @unique @map("board_mac_address") @db.VarChar(17)
  locationName    String   @map("location_name") @db.VarChar(100)
  latitude        Decimal  @db.Decimal(10, 8)
  longitude       Decimal  @db.Decimal(11, 8)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("boards")
}
