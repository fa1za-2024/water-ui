# Water UI - backend environment template
# Copy to .env:  cp .env.example .env
#
# Inside Docker the remaining hosts are COMPOSE SERVICE NAMES (mysql, influxdb).
# Running the API directly on your machine instead? Swap those for localhost.
# The MQTT broker is external (EMQX), so its host is a public DNS name either way.

NODE_ENV=development
PORT=5000

# --- MySQL (Prisma) ---------------------------------------------------------
DATABASE_URL="mysql://water_user:supersecretuser@mysql:3306/water_ui"

# --- Auth -------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# --- InfluxDB ---------------------------------------------------------------
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=waterui-dev-token-change-me
INFLUXDB_ORG=water_ui_org
INFLUXDB_BUCKET=water_quality_bucket

# --- MQTT (external EMQX Serverless) ----------------------------------------
# The simulator (and, once Node-RED is retired, the ingest service) uses these.
# TLS is inferred from the mqtts:// scheme the Simulator UI sends; these values
# supply the credentials. Copy the real values from docs/emqx broker.txt.
MQTT_HOST=n1119107.ala.asia-southeast1.emqxsl.com
MQTT_PORT=8883
MQTT_USE_TLS=true
MQTT_USERNAME=your-emqx-username
MQTT_PASSWORD=your-emqx-password

# --- CORS / Socket.io -------------------------------------------------------
# Comma-separated origins. Use * only for local development.
CORS_ORIGIN=http://localhost:5173,http://localhost

# --- Users module -----------------------------------------------------------
# Single-user system: registration bootstraps the one profile, then returns 409.
# Set to false once the profile exists to close the endpoint entirely.
ALLOW_REGISTRATION=true

# --- Prisma seed ------------------------------------------------------------
SEED_PASSWORD=waterui123
