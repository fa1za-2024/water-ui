# Water UI - backend environment template
# Copy to .env:  cp .env.example .env
#
# Inside Docker every host is a COMPOSE SERVICE NAME (mysql, influxdb, minio,
# mosquitto). Running the API directly on your machine instead? Swap those for
# localhost.

NODE_ENV=development
PORT=5000

# --- MySQL (Prisma) ---------------------------------------------------------
DATABASE_URL="mysql://water_user:supersecretuser@mysql:3306/water_ui"

# --- Auth -------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# --- InfluxDB ---------------------------------------------------------------
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=waterui-dev-token-change-me
INFLUXDB_ORG=water_ui_org
INFLUXDB_BUCKET=water_quality_bucket

# --- MinIO (profile pictures) ----------------------------------------------
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=profile-pictures

# --- MinIO (profile pictures) ----------------------------------------------
# MINIO_ENDPOINT/PORT are how the BACKEND reaches MinIO (the compose service
# name). MINIO_PUBLIC_URL is what the BROWSER uses, so it must be reachable from
# the host - the browser cannot resolve `minio`.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=profile-pictures
MINIO_PUBLIC_URL=http://localhost:9000

# --- CORS / Socket.io -------------------------------------------------------
# Comma-separated origins. Use * only for local development.
CORS_ORIGIN=http://localhost:5173,http://localhost

# --- Users module -----------------------------------------------------------
# Single-user system: registration bootstraps the one profile, then returns 409.
# Set to false once the profile exists to close the endpoint entirely.
ALLOW_REGISTRATION=true

# --- Prisma seed ------------------------------------------------------------
SEED_PASSWORD=waterui123
